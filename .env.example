# Mau cau hinh bien moi truong cho ung dung ChatNTQ RAG
# Saochep file nay thanh file .env de thiet lap truoc khi chay
# PowerShell: Copy-Item .env.example .env

# API Key cho Google Gemini LLM (Lay tai https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest

# Mo hinh nhung vector cuc bo (sentence-transformers)
EMBED_MODEL=intfloat/multilingual-e5-base

# Tham so thiet lap quy trinh RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
